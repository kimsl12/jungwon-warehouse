# Supabase
# Get these from Supabase Dashboard > Project Settings > API Keys
#
# New API key format (2025+) — preferred:
#   sb_publishable_*  for the browser key
#   sb_secret_*       for the server-only key
# Legacy JWT format (eyJ...) also still works.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-key

# Used by `supabase` CLI for type generation
SUPABASE_PROJECT_ID=your-project-id

# -----------------------------------------------------------------------------
# 팩스 API — 발주서 팩스 전송에 사용 (서버 전용).
# 셋 모두 비어 있으면 "팩스 발송" 버튼이 비활성화된다.
# 스마트팩스(한국정보통신) 기준:
#   FAX_API_BASE_URL  예) https://api.ksnet.co.kr/fax/v1
#   FAX_API_KEY       서비스 콘솔에서 발급받은 Bearer 토큰
#   FAX_SENDER_NUMBER 정원전기 발신 번호 예) 02-2645-0421
# 다른 공급자로 바꿀 때는 FAX_API_PROVIDER 를 지정 (기본 "smartfax")
# -----------------------------------------------------------------------------
FAX_API_PROVIDER=smartfax
FAX_API_BASE_URL=
FAX_API_KEY=
FAX_SENDER_NUMBER=
